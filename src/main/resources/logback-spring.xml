<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="APP_NAME" value="app"/>
    <!-- LOG_PATH is set via logging.file.path in application-prod.yml.
         The ${user.home} fallback applies only in dev/test environments. -->
    <property name="LOG_PATH" value="${LOG_PATH:-${user.home}/${APP_NAME}/logs}"/>

    <springProperty scope="context" name="ACTIVE_PROFILE" source="spring.profiles.active" defaultValue="dev"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %thread | %X{traceId:-none} | %logger{36} | %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %thread | %X{traceId:-none} | %logger{36} | %msg%n</pattern>
        </encoder>
    </appender>

    <!-- This resolver logs every exception it resolves at WARN, rendering the exception's own
         toString(). For MethodArgumentNotValidException that is the whole BindingResult, and
         FieldError.toString() carries "rejected value [...]" - the submitted password in
         cleartext whenever a password policy check rejects one. The root logger is INFO, so the
         line was written in every profile, into a 500MB rolling file operators read and log
         shippers forward. GlobalExceptionHandler answers each of these exceptions itself and
         logs the field and constraint code without the value, so the framework's copy is
         redundant as well as unsafe. Pinned to ERROR rather than OFF so the resolver can still
         report a genuine failure; only its WARN tier renders the payload. -->
    <logger name="org.springframework.web.servlet.mvc.method.annotation.ExceptionHandlerExceptionResolver" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
